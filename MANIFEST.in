include README.md
include LICENSE
include environment.yml
recursive-include envs *
recursive-include pelican/databases *
include pelican/models/*.py
include pelican/models/cnn_autoencoder_trained.pt
include pelican/models/minmax_scaler.pkl
include pelican/genemarks/python_wrapper.py
